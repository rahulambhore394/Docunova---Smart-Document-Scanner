<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Docunova" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryDark">@color/blue_500</item>
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Widget.Material3.BottomNavigationView.ActiveIndicator" parent="">
        <item name="android:color">#EEF2FF</item>
        <item name="android:width">46dp</item>
        <item name="android:height">30dp</item>
        <item name="cornerSize">15dp</item>
    </style>

    <style name="BottomNav.TextAppearance.Active" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#2563EB</item>
    </style>

    <style name="BottomNav.TextAppearance.Inactive" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10.5sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#64748B</item>
    </style>


    <style name="TextAppearance.MaterialComponents.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1" tools:ignore="ResourceCycle">
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.009</item>
    </style>

    <style name="Theme.Docunova" parent="Base.Theme.Docunova" />

    <style name="OptionTextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/selector_option_bg</item>
        <item name="android:layout_marginBottom">9dp</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MaterialComponents.MaterialAlertDialog</item>
        <item name="android:windowAnimationStyle">@style/DialogAnimation</item>
    </style>

    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>


</resources>