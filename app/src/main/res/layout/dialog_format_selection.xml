<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <View
            android:layout_width="4dp"
            android:layout_height="24dp"
            android:background="@color/blue_500" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Choose Export Format"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select the file type you want to generate and upload to your cloud storage."
        android:textColor="@color/gray_600"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <!-- PDF Option -->
    <LinearLayout
        android:id="@+id/option_pdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_option_selector"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon_pdf"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_pdf"
            android:layout_marginEnd="16dp"
            app:tint="@color/pdf_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_pdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF Document"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best for sharing and printing"
                android:textColor="@color/gray_600"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/check_pdf"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/blue_500" />

    </LinearLayout>

    <!-- Word Option -->
    <LinearLayout
        android:id="@+id/option_word"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_option_selector"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon_word"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_word"
            android:layout_marginEnd="16dp"
            app:tint="@color/word_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Word Document"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fully editable .docx format"
                android:textColor="@color/gray_600"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/check_word"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/blue_500" />

    </LinearLayout>

    <!-- Text Option -->
    <LinearLayout
        android:id="@+id/option_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@drawable/bg_option_selector"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/icon_text"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_text"
            android:layout_marginEnd="16dp"
            app:tint="@color/text_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plain Text"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Simple .txt file with raw text"
                android:textColor="@color/gray_600"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/check_text"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            app:tint="@color/blue_500" />

    </LinearLayout>

    <!-- Continue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Confirm &amp; Upload"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/blue_500"
        app:rippleColor="@color/ripple_effect_color" />

</LinearLayout>