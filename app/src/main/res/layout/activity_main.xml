<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern Floating Bottom Navigation Container -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="34dp"
        app:cardElevation="10dp"
        app:strokeWidth="1.2dp"
        app:strokeColor="#18000000"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemIconTint="@color/nav_item_selector"
            app:itemTextColor="@color/nav_item_selector"
            app:itemRippleColor="#152563EB"
            app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"
            app:itemTextAppearanceActive="@style/BottomNav.TextAppearance.Active"
            app:itemTextAppearanceInactive="@style/BottomNav.TextAppearance.Inactive"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_navigation_menu" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Elevated Center Quick-Scan Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fab_quick_scan"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#2563EB"
        app:cardCornerRadius="28dp"
        app:cardElevation="14dp"
        app:cardPreventCornerOverlap="false"
        app:rippleColor="#40FFFFFF"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="3.5dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCard"
        app:layout_constraintEnd_toEndOf="@id/bottomNavCard"
        app:layout_constraintStart_toStartOf="@id/bottomNavCard"
        app:layout_constraintTop_toTopOf="@id/bottomNavCard">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_fab_scan_gradient"
            android:contentDescription="Quick Scan"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_camera_24"
            app:tint="#FFFFFF" />
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
