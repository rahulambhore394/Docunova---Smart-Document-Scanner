<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dashed_border"
        android:backgroundTint="#CBD5E1" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="18dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_squircle_blue">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sort"
                app:tint="#2563EB"
                android:contentDescription="Sort &amp; Filter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sort &amp; Filter"
                android:textColor="#0F172A"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Customize your document vault view"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnResetFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset"
            android:textColor="#2563EB"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <!-- Section 1: Sort By -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SORT ORDER"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginBottom="10dp" />

    <RadioGroup
        android:id="@+id/rgSortOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="18dp">

        <RadioButton
            android:id="@+id/rbSortDateNewest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Date: Newest to Oldest"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />

        <RadioButton
            android:id="@+id/rbSortDateOldest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Date: Oldest to Newest"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />

        <RadioButton
            android:id="@+id/rbSortNameAsc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Name: A to Z"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />

        <RadioButton
            android:id="@+id/rbSortNameDesc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Name: Z to A"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />

        <RadioButton
            android:id="@+id/rbSortSizeLargest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Size: Largest to Smallest"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />

        <RadioButton
            android:id="@+id/rbSortSizeSmallest"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Size: Smallest to Largest"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:buttonTint="#2563EB" />
    </RadioGroup>

    <!-- Apply Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnApplySortFilter"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Apply"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        app:cornerRadius="16dp"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        android:backgroundTint="#2563EB"
        app:elevation="2dp"
        app:rippleColor="@color/ripple_effect_color" />

</LinearLayout>
